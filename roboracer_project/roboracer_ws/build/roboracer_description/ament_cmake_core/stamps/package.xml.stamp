<?xml version="1.0"?>
<package format="3">
  <name>roboracer_description</name>
  <version>0.0.0</version>
  <description>Roboracer robot description package</description>
  <maintainer email="ahmaddurranitrg@gmail.com">loq</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies -->
  <depend>ros_ign_gazebo</depend>
  <depend>ros_ign_bridge</depend>
  <depend>ros_ign_control</depend>
  <exec_depend condition="$ROS_DISTRO == humble">ign_ros2_control</exec_depend>
  <depend>ros_ign_interfaces</depend>
  <depend>ros_ign_image</depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <!-- Add mesh files to ament resource index -->
  <export>
    <build_type>ament_cmake</build_type>
    <ament_resource>meshes</ament_resource>
    <ignition_gazebo_ros plugin="${prefix}/ros_ign_bridge_plugin.xml"/>
  </export>
</package>