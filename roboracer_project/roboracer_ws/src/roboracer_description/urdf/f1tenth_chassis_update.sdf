<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="box_obstacle">
    <link name="link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.5</size> <!-- 20cm x 20cm x 50cm -->
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient> <!-- Red color for visibility -->
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.2 0.2 0.5</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>