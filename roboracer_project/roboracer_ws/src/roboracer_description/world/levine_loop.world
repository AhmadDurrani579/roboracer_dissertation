<?xml version="1.0"?>
<sdf version="1.9">
  <world name="levine_loop_world">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>
    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <solver>
                  <type>quick</type>
                  <iters>50</iters>
                  <precon_iters>0</precon_iters>
                  <sor>1.3</sor>  <!-- Relaxation factor -->
                </solver>
                <constraints>
                  <cfm>1e-5</cfm>  <!-- Contact "softness" -->
                  <erp>0.2</erp>   <!-- Error reduction -->
                </constraints>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Model for Walls -->
    <model name="levine_walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <!-- Outer Walls -->
      <link name="outer_wall_north">
        <collision name="collision">
          <geometry>
            <box>
              <size>60 0.1 2</size>
            </box>
          </geometry>
          <pose>0 0 1 0 0 0</pose>
        </collision>
        <visual name="visual">
          <pose>0 0 1 0 0 0</pose>
          <geometry>
            <box>
              <size>60 0.1 2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <pose>0 20 0 0 0 0</pose>
      </link>
