<?xml version="1.0"?>
<robot name="roboracer_robot">

  <static>false</static>
  <allow_auto_disable>false</allow_auto_disable>

  
  <!-- Base robot frame -->
  <link name="car_1_base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>


  <!-- ================== MAIN ROBOT STRUCTURE ================== -->
  <!-- Chassis -->
  <link name="car_1_chassis">
    <visual>
      <origin xyz="0.46 -0.135 -0.180" rpy="1.57 0 3.14"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/chassis.stl" scale="0.000990 0.0009375 0.0009375"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.010609" ixy="0" ixz="0" iyy="0.050409" iyz="0" izz="0.05865"/>
    </inertial>
  </link>

  <joint name="car_1_base_link_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="car_1_base_link"/>
    <child link="car_1_chassis"/>
  </joint>

  <!-- Removed car_1_chassis_inertia (redundant, merged into chassis) -->

  <!-- ================== DRIVETRAIN ================== -->
  <!-- Left Rear Wheel -->
  <link name="car_1_left_rear_wheel">
    <inertial>
      <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
      <mass value="0.34055"/>
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/left_wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- No Z-offset! -->
      <geometry>
        <cylinder radius="0.05" length="0.045"/>
      </geometry>
    </collision>
    
  </link>

  <joint name="car_1_left_rear_wheel_joint" type="continuous">
    <origin xyz="0 0.1 0" rpy="1.5708 0 0"/>
    <parent link="car_1_chassis"/>
    <child link="car_1_left_rear_wheel"/>
    <axis xyz="0 0 -1"/> <!-- Inverted -->
    <limit effort="10" velocity="100"/>
    <!-- <dynamics>
      <damping>0.1</damping>
      <friction>0.0</friction>
    </dynamics> -->
  </joint>

  <!-- Right Rear Wheel -->
  <link name="car_1_right_rear_wheel">
    <inertial>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <mass value="0.34055"/>
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/right_wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="car_1_right_rear_wheel_joint" type="continuous">
    <origin xyz="0 -0.1 0" rpy="1.5708 0 0"/>
    <parent link="car_1_chassis"/>
    <child link="car_1_right_rear_wheel"/>
    <axis xyz="0 0 -1"/> <!-- Inverted -->
    <limit effort="10" velocity="100"/>
  </joint>

  <!-- ================== STEERING SYSTEM ================== -->
  <!-- Left Steering Hinge -->
  <link name="car_1_left_steering_hinge">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.100"/>
      <inertia ixx="4E-06" ixy="0" ixz="0" iyy="4E-06" iyz="0" izz="4E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/hinge.stl"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="car_1_left_steering_hinge_joint" type="revolute">
    <parent link="car_1_chassis"/>
    <child link="car_1_left_steering_hinge"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.325 0.1 0" rpy="0 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="100" velocity="10"/>
    <!-- <dynamics>
      <damping>0.0</damping>
      <friction>0.0</friction>
    </dynamics> -->
  </joint>
  
  <!-- Right Steering Hinge -->
  <link name="car_1_right_steering_hinge">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.100"/>
      <inertia ixx="4E-06" ixy="0" ixz="0" iyy="4E-06" iyz="0" izz="4E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/hinge.stl"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="car_1_right_steering_hinge_joint" type="revolute">
    <origin xyz="0.325 -0.1 0" rpy="0 0 0"/> <!-- Adjusted rotation -->
    <parent link="car_1_chassis"/>
    <child link="car_1_right_steering_hinge"/>
    <axis xyz="0 0 1"/> <!-- Steering around Z-axis -->
    <limit lower="-0.3" upper="0.3" effort="100" velocity="10"/>

    
  </joint>

  <!-- Front Wheels -->
  <link name="car_1_left_front_wheel">
    <inertial>
      <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
      <mass value="0.34055"/>
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/left_wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="car_1_left_front_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <parent link="car_1_left_steering_hinge"/>
    <child link="car_1_left_front_wheel"/>
    <axis xyz="0 0 -1"/> <!-- Inverted -->
    <limit effort="10" velocity="100"/>
  </joint>

  <link name="car_1_right_front_wheel">
    <inertial>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <mass value="0.34055"/>
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/right_wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="car_1_right_front_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <parent link="car_1_right_steering_hinge"/>
    <child link="car_1_right_front_wheel"/>
    <axis xyz="0 0 -1"/> <!-- Inverted -->
    <limit effort="10" velocity="100"/>
  </joint>

  <!-- ================== SENSORS ================== -->
  <!-- LiDAR -->
  <link name="car_1_laser">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- Centered (offset handled in joint) -->
      <mass value="0.5"/>  <!-- Approx. mass of Hokuyo UST-10LX -->
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>  <!-- Rough estimate -->
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/loq/roboracer_ws/src/roboracer_description/meshes/laser_link.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="car_1_lidar_joint" type="fixed">
    <origin xyz="0.1 0 0.3" rpy="0 0 0"/>
    <parent link="car_1_base_link"/>
    <child link="car_1_laser"/>
  </joint>

  <!-- IMU -->
  <link name="car_1_imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0.1 0 0.1" rpy="0 0 0"/>
    <parent link="car_1_chassis"/>
    <child link="car_1_imu_link"/>
  </joint>

  <!-- Camera -->
   <link name="car_1_camera_link">
    <visual>
    <geometry>
    <box size="0.05 0.05 0.05"/> <!-- Compact camera housing -->
    </geometry>
    <material name="black"/>
    </visual>
    <inertial>
    <mass value="0.05"/>
    <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

    <!-- Camera Mounting Joint -->  
    <joint name="car_1_camera_joint" type="fixed">
    <origin xyz="0.40 0 0.10" rpy="0 0 0"/> <!-- Front-mounted position -->
    <parent link="car_1_chassis"/>
    <child link="car_1_camera_link"/>
    </joint>



  <!-- ================== GAZEBO PLUGINS ================== -->
  <!-- Sensors System -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <frameName>car_1_laser</frameName>
      <frameName>car_1_camera_link</frameName>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"></plugin>
  </gazebo>

    <!-- Hokuyo LIDAR Sensor -->


  <gazebo reference="car_1_laser">
    <sensor name="hokuyo_sensor" type="gpu_lidar">
      <gz_frame_id>car_1_laser</gz_frame_id>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <topic>/hokuyo/scan</topic>
      <pose>0 0 0 0 0 0</pose>  <!-- No rotation (forward-facing) -->
      <update_rate>40</update_rate>  <!-- F1/10th Change: Increased from 20Hz to 40Hz -->
      <lidar>
        <scan>
          <horizontal>
            <samples>1081</samples>  <!-- F1/10th Change: 1081 samples (odd number for symmetry) -->
            <resolution>1.0</resolution>
            <min_angle>-2.3561944902</min_angle>  <!-- F1/10th Change: -135° (270° FOV) -->
            <max_angle>2.3561944902</max_angle>   <!-- F1/10th Change: +135° -->
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1.0</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>  <!-- F1/10th Change: Added noise model -->
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  

  <!-- IMU Sensor -->
  <gazebo reference="car_1_imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/model/car_1/imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


<gazebo reference="car_1_camera_link">
  <sensor name="camera_sensor" type="camera">
    <gz_frame_id>car_1_camera_link</gz_frame_id>
    <always_on>true</always_on>
    <update_rate>30.0</update_rate>
    <visualize>true</visualize>
    <topic>/camera/image_raw</topic>
    <camera name="head">
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>10.0</far>
      </clip>
      <lens>
        <type>pinhole</type>
      </lens>
    </camera>
  </sensor>
</gazebo>


  <!-- Ackermann Steering Control -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>car_1_left_rear_wheel_joint</left_joint>
      <right_joint>car_1_right_rear_wheel_joint</right_joint>
      <left_steering_joint>car_1_left_steering_hinge_joint</left_steering_joint>
      <right_steering_joint>car_1_right_steering_hinge_joint</right_steering_joint>
      <kingpin_width>0.2</kingpin_width>
      <steering_limit>0.8</steering_limit>
      <wheel_base>0.325</wheel_base>
      <wheel_separation>0.2</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <min_velocity>-3.0</min_velocity>
      <max_velocity>3.0</max_velocity>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>/model/car_1/cmd_vel</topic>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>

    <!-- Odometry Publisher -->

    <!-- <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>car_1_base_link</robot_base_frame>
      <odom_topic>/model/car_1/odometry</odom_topic>
      <odom_publish_rate>50</odom_publish_rate>
      <tf_publish_rate>50</tf_publish_rate>
    </plugin> -->
  </gazebo>


  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/car_1/joint_state</topic>
      <joint_name>car_1_left_rear_wheel_joint</joint_name>
      <joint_name>car_1_right_rear_wheel_joint</joint_name>
      <joint_name>car_1_left_front_wheel_joint</joint_name>
      <joint_name>car_1_right_front_wheel_joint</joint_name>
      <joint_name>car_1_left_steering_hinge_joint</joint_name>
      <joint_name>car_1_right_steering_hinge_joint</joint_name>
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>

     
<!-- REAR WHEELS (Drive wheels) -->
<gazebo reference="car_1_left_rear_wheel">
  <mu1>1.8</mu1>    <!-- Longitudinal friction (accel/braking) -->
  <mu2>1.5</mu2>    <!-- Lateral friction (cornering) -->
  <kp>1.0e6</kp>    <!-- Stiffness (prevents penetration) -->
  <kd>100.0</kd>    <!-- Damping (absorbs oscillations) -->
  <fdir1>0 1 0</fdir1>  <!-- Friction direction (tangent to rolling) -->
</gazebo>

<gazebo reference="car_1_right_rear_wheel">
  <mu1>1.8</mu1>
  <mu2>1.5</mu2>
  <kp>1.0e6</kp>
  <kd>100.0</kd>
  <fdir1>0 1 0</fdir1>
</gazebo>

<!-- FRONT WHEELS (Steering wheels) -->
<gazebo reference="car_1_left_front_wheel">
  <mu1>1.8</mu1>    <!-- Same as rear wheels! -->
  <mu2>1.5</mu2>
  <kp>1.0e6</kp>
  <kd>100.0</kd>
  <fdir1>0 1 0</fdir1>
</gazebo>

<gazebo reference="car_1_right_front_wheel">
  <mu1>1.8</mu1>
  <mu2>1.5</mu2>
  <kp>1.0e6</kp>
  <kd>100.0</kd>
  <fdir1>0 1 0</fdir1>
</gazebo>

<gazebo reference="car_1_chassis">
  <mu1>1.5</mu1>  <!-- Friction with ground -->
  <mu2>1.2</mu2>
</gazebo>

  <!-- ================== MATERIALS ================== -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
</robot>